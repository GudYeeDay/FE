{
  "expo": {
    "name": "GudYeeDay",
    "slug": "gudyeeday",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gudyeeday.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gudyeeday.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "imageWidth": 104,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "미션 기록에 올릴 사진을 고르기 위해 사진 보관함에 접근해요.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "기록을 이미지로 저장하기 위해 사진 보관함에 접근해요.",
          "savePhotosPermission": "기록을 이미지로 저장하기 위해 사진 보관함에 접근해요.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "scheme": "gudyeeday",
    "experiments": {
      "typedRoutes": true
    }
  }
}
